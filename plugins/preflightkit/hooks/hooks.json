{
  "description": "PreflightKit deploy gate: run the security check before Claude deploys",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/deploy-gate.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
